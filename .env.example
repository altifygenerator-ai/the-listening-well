# Server
PORT=3000
APP_URL=http://localhost:3000

# OpenAI (optional; the app has a polished local fallback when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Supabase (optional; localStorage remains active as an offline-first fallback)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use this instead:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional; payment cards remain in preview mode until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COPPER_10=
STRIPE_PRICE_MOON_30=
STRIPE_PRICE_KEEPER_MONTHLY=


# Admin (server-only)
ADMIN_EMAILS=altifygenerator@gmail.com
# Generate a long random value, for example: openssl rand -hex 32
ADMIN_SETUP_TOKEN=
