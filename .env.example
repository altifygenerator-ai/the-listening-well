# Server
PORT=3000
APP_URL=http://localhost:3000

# OpenAI (required anywhere you want real wish responses; canned wish fallbacks are intentionally disabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional compatibility fallbacks; the app uses these defaults if omitted.
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_COMPAT_MODEL=gpt-4.1-mini

# Supabase (optional; localStorage remains active as an offline-first fallback)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use this instead:
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional; payment cards remain in preview mode until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COPPER_10=
STRIPE_PRICE_MOON_30=
STRIPE_PRICE_KEEPER_MONTHLY=


# Admin (server-only)
ADMIN_EMAILS=
# Generate a long random value, for example: openssl rand -hex 32
ADMIN_SETUP_TOKEN=
